{
  "name": "@zakkster/lite-noise",
  "version": "1.5.2",
  "description": "Zero-GC seeded Simplex 2D/3D noise, unrolled FBM, ridged/billow multifractals, seamless loop, tileable field, curl2, curl3, domain warp, and bakeable heightfields. Deterministic via seeded permutation table.",
  "author": "Zahary Shinikchiev <shinikchiev@yahoo.com>",
  "license": "MIT",
  "type": "module",
  "main": "./Noise.js",
  "module": "./Noise.js",
  "types": "./Noise.d.ts",
  "exports": {
    ".": {
      "types": "./Noise.d.ts",
      "node": "./Noise.js",
      "import": "./Noise.js",
      "default": "./Noise.js"
    }
  },
  "files": [
    "Noise.js",
    "Noise.d.ts",
    "llms.txt",
    "CHANGELOG.md",
    "LICENSE.txt",
    "README.md"
  ],
  "keywords": [
    "noise",
    "simplex",
    "fbm",
    "curl",
    "curl3",
    "domain-warp",
    "heightfield",
    "procedural",
    "terrain",
    "zero-gc"
  ],
  "sideEffects": false,
  "homepage": "https://github.com/PeshoVurtoleta/lite-noise#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeshoVurtoleta/lite-noise.git"
  },
  "bugs": {
    "url": "https://github.com/PeshoVurtoleta/lite-noise/issues",
    "email": "shinikchiev@yahoo.com"
  },
  "engines": {
    "node": ">=18"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/PeshoVurtoleta"
  },
  "devDependencies": {
    "@zakkster/lite-ambient-fx": "^1.8.0",
    "@zakkster/lite-gc-profiler": "^1.14.1",
    "@zakkster/lite-gl": "^1.4.0",
    "@zakkster/lite-gradient-studio": "^1.3.0",
    "@zakkster/lite-leak": "^1.8.1",
    "@zakkster/lite-particles": "^1.5.0",
    "@zakkster/lite-patternforge": "^1.0.0",
    "@zakkster/lite-signal": ">=1.7.0-alpha.4",
    "esbuild": "^0.25.0"
  },
  "overrides": {
    "@zakkster/lite-signal": "$@zakkster/lite-signal"
  },
  "scripts": {
    "test": "node --expose-gc --test \"test/**/*.test.js\"",
    "torture": "node --expose-gc test/torture.mjs",
    "bench": "node magnitudes/bench/terrain.mjs",
    "bundle-check": "node magnitudes/scripts/bundle-check.mjs",
    "goldens": "node magnitudes/scripts/regenerate-goldens.mjs",
    "verify": "npm test && npm run torture && npm run bundle-check",
    "prepublishOnly": "npm run verify"
  }
}
